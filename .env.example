# ============================================================
# SYSTEM CONFIGURATION AND MONGODB ATLAS SETTINGS
# Rename this file to .env or configure in Streamlit secrets
# ============================================================

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# e.g.: mongodb+srv://rupesh:MyPassword123@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=defect_prediction_db

# Default Administrator Account (Seeded on first startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@defectprediction.ai
ADMIN_PASSWORD=Admin@Defect2026!
ADMIN_FULL_NAME=System Administrator

# Application Security
APP_SECRET_KEY=defect_prediction_secret_key_2026_academic
